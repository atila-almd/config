[Unit]
Description=Walker launcher application service
Documentation=https://github.com/abenz1267/walker
Requires=elephant.service
After=blendos-workstation-session.target
After=elephant.service
PartOf=blendos-workstation-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
ExecStart=%h/.local/bin/blend_bin/session-walker --gapplication-service
Restart=on-failure
RestartSec=2s
Slice=session-graphical.slice

[Install]
WantedBy=blendos-workstation-session.target
