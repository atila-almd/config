[Unit]
Description=Independent Workstation session lock
Requisite=graphical-session.target
After=graphical-session.target
PartOf=blendos-workstation-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/blend_bin/session-workstation-lock --run
Environment=PATH=%h/.local/bin/blend_bin:/usr/local/bin:/usr/bin
UMask=0077
Restart=on-failure
RestartSec=1
