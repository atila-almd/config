[Unit]
Description=VirtualBox VMSVGA session assistant
PartOf=blendos-workstation-session.target
After=blendos-workstation-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionVirtualization=oracle

[Service]
Type=simple
ExecStart=/usr/bin/VBoxClient --session-type wayland --vmsvga-session --foreground
Restart=on-failure
RestartSec=2
Slice=session-graphical.slice
