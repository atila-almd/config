[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = 10x52
    width = (320, 560)
    height = (0, 300)
    notification_limit = 8
    indicate_hidden = yes
    shrink = no
    transparency = 8
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 1
    corner_radius = 18
    sort = urgency_ascending
    idle_threshold = 120
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = yes
    hide_duplicate_count = no
    show_indicators = yes
    icon_position = left
    min_icon_size = 0
    max_icon_size = 48
    icon_theme = Papirus-Dark,Adwaita
    enable_recursive_icon_lookup = yes
    sticky_history = yes
    history_length = 50
    startup_notification = false
    ignore_dbusclose = false
    force_xwayland = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    browser = /usr/bin/xdg-open
    dmenu = /usr/bin/walker --dmenu --placeholder Action
    per_monitor_dpi = false
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 500

[experimental]
    per_monitor_dpi = false

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 8

[urgency_critical]
    timeout = 0
