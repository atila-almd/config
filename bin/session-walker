#!/usr/bin/env bash

set -Eeuo pipefail

profile="$(cat "${BLENDOS_WORKSTATION_PROFILE_FILE:-/etc/blendos-workstation/machine-profile}" 2>/dev/null || true)"
if [[ "$profile" == vm ]]; then
  # VirtualBox's accelerated VMSVGA path crashes Walker's GTK renderer.
  export GSK_RENDERER="${GSK_RENDERER:-cairo}"
fi

if ! walker_bin="$(command -v walker)"; then
  printf 'session-walker: walker is not installed or not in PATH\n' >&2
  exit 127
fi

exec "$walker_bin" "$@"
