#!/usr/bin/env bash

set -Eeuo pipefail

program_name="${0##*/}"
resolved_script="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || true)"
if [[ -z "$resolved_script" || ! -f "$resolved_script" ]]; then
  printf '%s: unable to resolve the helper path\n' "$program_name" >&2
  exit 1
fi
script_dir="$(cd -- "$(dirname -- "$resolved_script")" && pwd -P)"
repo_dir="$(cd -- "$script_dir/.." && pwd -P)"

builtin_home="${BLENDOS_WORKSTATION_THEME_BUILTIN_HOME:-$repo_dir/themes}"
config_home="${BLENDOS_WORKSTATION_THEME_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}"
state_home="${BLENDOS_WORKSTATION_THEME_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}}"
user_theme_home="$config_home/blendos-workstation/themes"
theme_state_root="$state_home/blendos-workstation/theme"
release_root="$theme_state_root/releases"
current_link="$theme_state_root/current"
previous_link="$theme_state_root/previous"
selected_file="$theme_state_root/selected"
template_root="$builtin_home/templates"
staging_to_cleanup=''
trap 'if [[ -n "$staging_to_cleanup" && -d "$staging_to_cleanup" && ! -L "$staging_to_cleanup" ]]; then rm -rf -- "$staging_to_cleanup"; fi' EXIT

readonly -a color_keys=(
  accent selection muted background background_alt surface surface_alt
  foreground foreground_muted red orange yellow green cyan blue magenta
)
readonly -a template_files=(
  'workstation-shell.json.tpl:workstation-shell.json'
  'walker.css.tpl:walker.css'
  'dunst-theme.conf.tpl:dunst-theme.conf'
  'hyprland-theme.lua.tpl:hyprland-theme.lua'
  'ghostty-theme.conf.tpl:ghostty-theme.conf'
  'gtk-3.0-settings.ini.tpl:gtk-3.0-settings.ini'
  'gtk-4.0-settings.ini.tpl:gtk-4.0-settings.ini'
)
readonly envsubst_variables='$THEME_RELEASE_ID $THEME_ID $THEME_MODE $THEME_FONT $THEME_GTK_THEME $THEME_GTK_ICON_THEME $THEME_GTK_CURSOR_THEME $THEME_GTK_PREFER_DARK $THEME_ACCENT $THEME_ACCENT_NOHASH $THEME_SELECTION $THEME_MUTED $THEME_MUTED_NOHASH $THEME_BACKGROUND $THEME_BACKGROUND_NOHASH $THEME_BACKGROUND_ALT $THEME_SURFACE $THEME_SURFACE_ALT $THEME_FOREGROUND $THEME_FOREGROUND_MUTED $THEME_RED $THEME_ORANGE $THEME_YELLOW $THEME_GREEN $THEME_CYAN $THEME_BLUE $THEME_MAGENTA $THEME_MAGENTA_NOHASH $THEME_PALETTE_0 $THEME_PALETTE_1 $THEME_PALETTE_2 $THEME_PALETTE_3 $THEME_PALETTE_4 $THEME_PALETTE_5 $THEME_PALETTE_6 $THEME_PALETTE_7 $THEME_PALETTE_8 $THEME_PALETTE_9 $THEME_PALETTE_10 $THEME_PALETTE_11 $THEME_PALETTE_12 $THEME_PALETTE_13 $THEME_PALETTE_14 $THEME_PALETTE_15'

fail() {
  printf '%s: %s\n' "$program_name" "$*" >&2
  exit 1
}

need_command() {
  command -v -- "$1" >/dev/null 2>&1 || fail "required command is unavailable: $1"
}

ensure_state_root() {
  [[ ! -L "$theme_state_root" ]] || fail "theme state root must not be a symlink: $theme_state_root"
  [[ ! -L "$theme_state_root/../theme" ]] || fail "theme state root must not be a symlink: $theme_state_root"
  install -d -m0700 -- "$state_home/blendos-workstation"
  [[ ! -L "$state_home/blendos-workstation" ]] || fail "state parent must not be a symlink"
  install -d -m0700 -- "$theme_state_root"
  [[ ! -L "$theme_state_root" ]] || fail "theme state root must not be a symlink"
  install -d -m0700 -- "$release_root"
  [[ ! -L "$release_root" ]] || fail "release root must not be a symlink"
  chmod 0700 -- "$theme_state_root" "$release_root"
}

source "$script_dir/workstation-appearance-common.sh"

json_value() {
  local expression="$1"
  local manifest="$2"
  jq -er "$expression" -- "$manifest"
}

theme_directory() {
  local theme_id="$1"
  local user_dir="$user_theme_home/$theme_id"
  local builtin_dir="$builtin_home/$theme_id"

  [[ "$theme_id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail "invalid theme ID: $theme_id"
  if [[ -f "$user_dir/theme.json" ]]; then
    printf '%s\n' "$user_dir"
  elif [[ -f "$builtin_dir/theme.json" ]]; then
    printf '%s\n' "$builtin_dir"
  else
    fail "unknown theme: $theme_id"
  fi
}

theme_ids() {
  local dir id
  declare -A seen=()
  local -a candidates=()

  shopt -s nullglob
  for dir in "$builtin_home"/* "$user_theme_home"/*; do
    [[ -d "$dir" && -f "$dir/theme.json" ]] || continue
    id="${dir##*/}"
    [[ "$id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || continue
    seen["$id"]=1
  done
  for id in "${!seen[@]}"; do
    candidates+=("$id")
  done
  ((${#candidates[@]})) || return 0
  printf '%s\n' "${candidates[@]}" | sort -u
}

validate_wallpaper_paths() {
  local theme_id="$1"
  local theme_dir="$2"
  local manifest="$theme_dir/theme.json"
  local theme_real wallpaper resolved path

  theme_real="$(resolved_or_empty "$theme_dir")"
  [[ -n "$theme_real" ]] || fail "unable to resolve theme directory: $theme_dir"
  case "$theme_real" in
    */"$theme_id") ;;
    *) fail "theme directory and manifest ID do not match: $theme_dir" ;;
  esac

  while IFS= read -r wallpaper; do
    [[ "$wallpaper" != /* && "$wallpaper" != ~* ]] ||
      fail "wallpaper path must be relative: $wallpaper"
    case "/$wallpaper/" in
      */../*) fail "wallpaper path traversal is not allowed: $wallpaper" ;;
    esac
    path="$theme_dir/$wallpaper"
    [[ -f "$path" ]] || fail "wallpaper file is missing: $path"
    resolved="$(resolved_or_empty "$path")"
    case "$resolved" in
      "$theme_real"/*) ;;
      *) fail "wallpaper resolves outside the theme directory: $wallpaper" ;
    esac
  done < <(jq -er '.wallpapers[].path' -- "$manifest")
}

validate_theme() {
  local theme_id="$1"
  local theme_dir manifest expected_id

  need_command jq
  theme_dir="$(theme_directory "$theme_id")"
  manifest="$theme_dir/theme.json"
  expected_id="${theme_dir##*/}"
  [[ "$expected_id" == "$theme_id" ]] || fail "theme directory and requested ID do not match"
  [[ -f "$manifest" ]] || fail "theme manifest is missing: $manifest"
  [[ ! -L "$manifest" ]] || fail "theme manifest must not be a symlink: $manifest"

  jq -e --arg expected_id "$theme_id" '
    . as $manifest |
    ($manifest.schema == 1) and
    ($manifest.id == $expected_id) and
    ($manifest.id | type == "string" and test("^[a-z0-9][a-z0-9-]*$")) and
    ($manifest.name | type == "string" and length > 0) and
    ($manifest.mode == "dark" or $manifest.mode == "light") and
    (["accent", "selection", "muted", "background", "background_alt", "surface", "surface_alt", "foreground", "foreground_muted", "red", "orange", "yellow", "green", "cyan", "blue", "magenta"] | all(.[]; ($manifest.colors[.] | type == "string" and test("^#[0-9A-Fa-f]{6}$")))) and
    ($manifest.terminal.palette | type == "array" and length == 16 and all(.[]; type == "string" and test("^#[0-9A-Fa-f]{6}$"))) and
    ($manifest.wallpapers | type == "array" and length > 0 and all(.[]; (.name | type == "string" and length > 0) and (.path | type == "string" and length > 0 and (startswith("/") | not) and (test("(^|/)\\.\\.($|/)") | not)))) and
    (["theme", "icon_theme", "cursor_theme"] | all(.[]; ($manifest.gtk[.] | type == "string" and length > 0)))
  ' -- "$manifest" >/dev/null || fail "manifest validation failed: $manifest"

  validate_wallpaper_paths "$theme_id" "$theme_dir"
}

manifest_for_theme() {
  local theme_id="$1"
  local theme_dir
  theme_dir="$(theme_directory "$theme_id")"
  printf '%s/theme.json\n' "$theme_dir"
}

load_theme_variables() {
  local manifest="$1"
  local release_dir="${2:-}"
  local key upper value raw

  THEME_ID="$(json_value '.id' "$manifest")"
  THEME_MODE="$(json_value '.mode' "$manifest")"
  THEME_FONT='JetBrainsMono Nerd Font'
  THEME_GTK_THEME="$(json_value '.gtk.theme' "$manifest")"
  THEME_GTK_ICON_THEME="$(json_value '.gtk.icon_theme' "$manifest")"
  THEME_GTK_CURSOR_THEME="$(json_value '.gtk.cursor_theme' "$manifest")"
  if [[ "$THEME_MODE" == 'dark' ]]; then
    THEME_GTK_PREFER_DARK=1
  else
    THEME_GTK_PREFER_DARK=0
  fi

  for key in "${color_keys[@]}"; do
    upper="${key^^}"
    value="$(json_value ".colors.$key" "$manifest")"
    printf -v "THEME_$upper" '%s' "$value"
    case "$key" in
      accent|muted|background|magenta)
        printf -v "THEME_${upper}_NOHASH" '%s' "${value#\#}"
        export "THEME_$upper" "THEME_${upper}_NOHASH"
        ;;
      *)
        export "THEME_$upper"
        ;;
    esac
  done

  for key in $(seq 0 15); do
    value="$(json_value ".terminal.palette[$key]" "$manifest")"
    printf -v "THEME_PALETTE_$key" '%s' "$value"
    export "THEME_PALETTE_$key"
  done

  THEME_RELEASE_ID="${release_dir##*/}"
  export THEME_ID THEME_MODE THEME_FONT THEME_RELEASE_ID
  export THEME_GTK_THEME THEME_GTK_ICON_THEME THEME_GTK_CURSOR_THEME THEME_GTK_PREFER_DARK
}

rendered_output_names() {
  printf '%s\n' \
    manifest.json walker.css dunst-theme.conf \
    hyprland-theme.lua ghostty-theme.conf gtk-3.0-settings.ini \
    gtk-4.0-settings.ini workstation-shell.json \
    wallpaper.png wallpaper-source
}

validate_rendered_release() {
  local release_dir="$1"
  local file
  assert_inside "$release_dir"
  [[ -d "$release_dir" && ! -L "$release_dir" ]] || fail "invalid release directory: $release_dir"
  while IFS= read -r file; do
    [[ -s "$release_dir/$file" ]] || fail "rendered output is missing or empty: $file"
    if [[ "$file" != 'manifest.json' && "$file" != 'wallpaper-source' && "$file" != 'wallpaper.png' ]]; then
      ! grep -Eq '\$\{THEME_[A-Z0-9_]+\}|\{\{' -- "$release_dir/$file" ||
        fail "unresolved template token in rendered output: $file"
    fi
  done < <(rendered_output_names)
  jq -e '.schema == 1 and (.id | type == "string")' -- "$release_dir/manifest.json" >/dev/null ||
    fail "rendered manifest is invalid: $release_dir/manifest.json"
  local expected_release="${release_dir##*/}"
  expected_release="${expected_release#.staging-}"
  jq -e --arg release "$expected_release" --slurpfile manifest "$release_dir/manifest.json" '
    .schema_version == 1 and .release_id == $release and .theme_id == $manifest[0].id and
    .mode == $manifest[0].mode and .colors == $manifest[0].colors and
    (keys | sort) == (["schema_version", "release_id", "theme_id", "mode", "colors"] | sort)
  ' -- "$release_dir/workstation-shell.json" >/dev/null ||
    fail 'rendered Workstation shell palette does not match the semantic theme'
  grep -Fq 'return {' -- "$release_dir/hyprland-theme.lua" ||
    fail 'rendered Hyprland theme is not a Lua table'
  if command -v identify >/dev/null 2>&1; then
    [[ "$(identify -format '%m' -- "$release_dir/wallpaper.png" 2>/dev/null || true)" == 'PNG' ]] ||
      fail 'rendered wallpaper is not a PNG'
  fi
}

render_release() {
  local theme_id="$1"
  local theme_dir manifest source wallpaper_path template_pair input output
  local release_name staging release_dir

  ensure_state_root
  validate_theme "$theme_id"
  theme_dir="$(theme_directory "$theme_id")"
  manifest="$theme_dir/theme.json"
  release_name="release-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
  staging="$release_root/.staging-$release_name"
  release_dir="$release_root/$release_name"
  [[ ! -e "$staging" && ! -L "$staging" && ! -e "$release_dir" && ! -L "$release_dir" ]] ||
    fail "release staging path already exists"
  assert_inside "$staging"
  install -d -m0700 -- "$staging"
  staging_to_cleanup="$staging"

  load_theme_variables "$manifest" "$release_dir"
  source="$(jq -er '.wallpapers[0].path' -- "$manifest")"
  wallpaper_path="$theme_dir/$source"
  render_wallpaper "$wallpaper_path" "$staging/wallpaper.png"

  cp -- "$manifest" "$staging/manifest.json"
  chmod 0644 -- "$staging/manifest.json" "$staging/wallpaper.png"
  printf '%s\n' "$wallpaper_path" > "$staging/wallpaper-source"
  chmod 0644 -- "$staging/wallpaper-source"

  for template_pair in "${template_files[@]}"; do
    input="${template_pair%%:*}"
    output="${template_pair#*:}"
    [[ -f "$template_root/$input" ]] || fail "missing theme template: $template_root/$input"
    envsubst "$envsubst_variables" < "$template_root/$input" > "$staging/$output"
    chmod 0644 -- "$staging/$output"
  done

  validate_rendered_release "$staging"
  chmod 0700 -- "$staging"
  assert_inside "$release_root"
  mv -T -- "$staging" "$release_dir"
  staging_to_cleanup=''
  printf '%s\n' "$release_dir"
}

link_atomic() {
  local target="$1"
  local link="$2"
  local temporary="$theme_state_root/.link-$$-$RANDOM"

  assert_inside "$link"
  [[ ! -e "$temporary" && ! -L "$temporary" ]] || fail "temporary pointer already exists"
  ln -s -- "$target" "$temporary"
  mv -T -- "$temporary" "$link"
}

pointer_target() {
  local pointer="$1"
  local target
  [[ -L "$pointer" ]] || return 0
  target="$(resolved_or_empty "$pointer")"
  [[ -n "$target" ]] || fail "broken theme pointer: $pointer"
  assert_inside "$target"
  printf '%s\n' "$target"
}

write_selected() {
  local theme_id="$1"
  local temporary="$theme_state_root/.selected-$$-$RANDOM"
  assert_inside "$temporary"
  if [[ -e "$selected_file" || -L "$selected_file" ]]; then
    [[ -f "$selected_file" && ! -L "$selected_file" ]] ||
      fail "selected theme state is not a regular file"
  fi
  printf '%s\n' "$theme_id" > "$temporary"
  chmod 0600 -- "$temporary"
  mv -T -- "$temporary" "$selected_file"
  chmod 0600 -- "$selected_file"
}

restore_selected_state() {
  local existed="$1"
  local value="$2"
  if [[ "$existed" == true ]]; then
    write_selected "$value"
  else
    rm -f -- "$selected_file"
  fi
}

service_active() {
  command -v systemctl >/dev/null 2>&1 || return 1
  systemctl --user is-active --quiet "$1" >/dev/null 2>&1
}

gsettings_set_if_writable() {
  local schema="$1"
  local key="$2"
  local value="$3"
  command -v gsettings >/dev/null 2>&1 || return 0
  gsettings list-schemas 2>/dev/null | grep -Fxq -- "$schema" || return 0
  gsettings writable "$schema" "$key" 2>/dev/null | grep -Fxq true || return 0
  gsettings set "$schema" "$key" "$value"
}

reload_gtk() {
  if ! command -v gsettings >/dev/null 2>&1; then
    printf '%s: gsettings unavailable; GTK settings will apply to new processes\n' "$program_name" >&2
    return 0
  fi
  gsettings_set_if_writable org.gnome.desktop.interface color-scheme \
    "$(if [[ "$THEME_MODE" == dark ]]; then printf prefer-dark; else printf default; fi)" || return 1
  gsettings_set_if_writable org.gnome.desktop.interface gtk-theme "$THEME_GTK_THEME" || return 1
  gsettings_set_if_writable org.gnome.desktop.interface icon-theme "$THEME_GTK_ICON_THEME" || return 1
  gsettings_set_if_writable org.gnome.desktop.interface cursor-theme "$THEME_GTK_CURSOR_THEME"
}

reload_hyprland() {
  local instances
  command -v hyprctl >/dev/null 2>&1 || return 0
  instances="$(hyprctl instances 2>/dev/null || true)"
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" || -n "$instances" ]]; then
    hyprctl reload
  fi
}

reload_dunst() {
  if service_active dunst.service; then
    if command -v dunstctl >/dev/null 2>&1 && dunstctl reload >/dev/null 2>&1; then
      return 0
    fi
    systemctl --user restart dunst.service
  fi
}

reload_walker() {
  service_active walker.service || return 0
  systemctl --user restart walker.service
}

reload_ghostty() {
  service_active app-com.mitchellh.ghostty.service || {
    printf '%s: standalone Ghostty windows require Ctrl+Shift+, to reload\n' "$program_name" >&2
    return 0
  }
  systemctl --user reload app-com.mitchellh.ghostty.service
}

reload_wallpaper() {
  local helper
  helper="$(command -v workstation-wallpaper || true)"
  if [[ -z "$helper" && -x "$script_dir/workstation-wallpaper" ]]; then
    helper="$script_dir/workstation-wallpaper"
  fi
  [[ -n "$helper" ]] || fail 'workstation-wallpaper helper is unavailable'
  "$helper" restore
}

reload_consumer() {
  local config="$1" expected="$2" attempt observed
  need_command qs
  timeout 3 qs -c "$config" ipc call -- theme reload || return 1
  for ((attempt=0; attempt<30; attempt++)); do
    observed="$(timeout 1 qs -c "$config" ipc call -- theme release 2>/dev/null)" || return 1
    [[ "$observed" != "$expected" ]] || return 0
    sleep 0.1
  done
  printf '%s: %s did not acknowledge the activated theme release\n' "$program_name" "$config" >&2
  return 1
}

reload_current() {
  local release manifest theme_id
  ensure_state_root
  release="$(pointer_target "$current_link")"
  [[ -n "$release" ]] || fail 'no active theme release exists'
  manifest="$release/manifest.json"
  [[ -f "$manifest" ]] || fail 'active release has no manifest'
  theme_id="$(jq -er '.id' -- "$manifest")"
  validate_theme "$theme_id"
  load_theme_variables "$manifest" "$release"
  reload_gtk || return 1
  reload_hyprland || return 1
  reload_dunst || return 1
  reload_walker || return 1
  reload_ghostty || return 1
  reload_wallpaper || return 1
  if systemctl --user is-active --quiet workstation-shell.service 2>/dev/null; then
    need_command qs
    reload_consumer workstation "${release##*/}" || return 1
  fi
  if service_active workstation-lock.service; then
    need_command qs
    reload_consumer workstation-lock "${release##*/}" || return 1
  fi
}

prune_releases() {
  local current_target previous_target release resolved index=0 keep=false
  local -a releases=()
  current_target="$(pointer_target "$current_link")"
  previous_target="$(pointer_target "$previous_link")"
  while IFS= read -r release; do
    [[ -n "$release" ]] && releases+=("$release")
  done < <(find "$release_root" -mindepth 1 -maxdepth 1 -type d -name 'release-*' -printf '%T@ %p\n' | sort -nr | cut -d' ' -f2-)

  for release in "${releases[@]}"; do
    resolved="$(resolved_or_empty "$release")"
    assert_inside "$resolved"
    keep=false
    [[ "$resolved" == "$current_target" || "$resolved" == "$previous_target" ]] && keep=true
    if ((index < 2)); then
      keep=true
    fi
    if [[ "$keep" == false ]]; then
      case "$resolved" in
        "$release_root"/release-*) rm -rf -- "$resolved" ;;
        *) fail "refusing to prune path outside release root: $resolved" ;;
      esac
    fi
    index=$((index + 1))
  done
}

set_theme() {
  local theme_id="$1"
  local no_reload="$2"
  local release old_current old_previous old_selected
  local old_current_exists=false old_previous_exists=false old_selected_exists=false

  ensure_state_root
  validate_theme "$theme_id"
  release="$(render_release "$theme_id")"
  if [[ -e "$current_link" || -L "$current_link" ]]; then
    [[ -L "$current_link" ]] || fail 'current theme pointer is not a symlink'
    old_current="$(pointer_target "$current_link")"
    old_current_exists=true
  else
    old_current=''
  fi
  if [[ -e "$previous_link" || -L "$previous_link" ]]; then
    [[ -L "$previous_link" ]] || fail 'previous theme pointer is not a symlink'
    old_previous="$(pointer_target "$previous_link")"
    old_previous_exists=true
  else
    old_previous=''
  fi
  if [[ -e "$selected_file" || -L "$selected_file" ]]; then
    [[ -f "$selected_file" && ! -L "$selected_file" ]] ||
      fail 'selected theme state is not a regular file'
    old_selected="$(cat -- "$selected_file")"
    old_selected_exists=true
  else
    old_selected=''
  fi

  if ! (
    if [[ "$old_current_exists" == true ]]; then
      link_atomic "$old_current" "$previous_link" || exit 1
    elif [[ "$old_previous_exists" == true ]]; then
      rm -f -- "$previous_link" || exit 1
    fi
    link_atomic "$release" "$current_link" || exit 1
    write_selected "$theme_id" || exit 1
    if [[ "$no_reload" == false ]]; then
      reload_current || exit 1
    fi
  ); then
    if [[ "$old_current_exists" == true ]]; then
      link_atomic "$old_current" "$current_link"
    else
      rm -f -- "$current_link"
    fi
    if [[ "$old_previous_exists" == true ]]; then
      link_atomic "$old_previous" "$previous_link"
    else
      rm -f -- "$previous_link"
    fi
    restore_selected_state "$old_selected_exists" "$old_selected"
    if [[ "$old_current_exists" == true ]]; then
      reload_current || true
    fi
    fail 'theme activation or reload failed; previous release restored'
  fi
  prune_releases
  printf 'Activated theme %s.\n' "$theme_id"
}

choose_theme() {
  local choices selected id name candidate
  local -a entries=()
  while IFS=$'\t' read -r id name; do
    [[ -n "$id" ]] || continue
    candidate="$name [$id]"
    entries+=("$candidate")
  done < <(while IFS= read -r id; do
    name="$(json_value '.name' "$(manifest_for_theme "$id")")"
    printf '%s\t%s\n' "$id" "$name"
  done < <(theme_ids))
  ((${#entries[@]})) || fail 'no themes are available'
  choices="$(printf '%s\n' "${entries[@]}")"
  selected="$(printf '%s\n' "$choices" | walker --dmenu --placeholder Theme || true)"
  [[ -n "$selected" ]] || return 0
  for candidate in "${entries[@]}"; do
    if [[ "$candidate" == "$selected" ]]; then
      id="${candidate##* [}"
      id="${id%]}"
      set_theme "$id" false
      return 0
    fi
  done
  fail 'theme chooser returned an unknown selection'
}

usage() {
  cat <<'EOF'
Usage:
  workstation-theme list
  workstation-theme snapshot
  workstation-theme current
  workstation-theme validate [THEME|--all]
  workstation-theme set THEME [--no-reload]
  workstation-theme choose
  workstation-theme reload
EOF
}

public_snapshot() {
  local release='' theme_id=null release_id=null themes='[]' id item
  if [[ -e "$current_link" || -L "$current_link" ]]; then
    [[ -L "$current_link" ]] || fail 'current theme pointer is invalid'
    release="$(pointer_target "$current_link")"
    [[ "$release" == "$release_root"/release-* && -f "$release/workstation-shell.json" ]] || fail 'active theme release is invalid'
    jq -e --arg release "${release##*/}" '.schema_version==1 and .release_id==$release and (.theme_id|type=="string")' -- "$release/workstation-shell.json" >/dev/null || fail 'active theme metadata is invalid'
    theme_id="$(jq -c .theme_id -- "$release/workstation-shell.json")"
    release_id="$(jq -c .release_id -- "$release/workstation-shell.json")"
  fi
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    item="$(jq -ce --arg id "$id" 'select(.schema==1 and .id==$id and (.name|type=="string" and length>0) and (.mode=="dark" or .mode=="light")) | {id:.id,label:.name,mode:.mode}' -- "$(manifest_for_theme "$id")")" || return 1
    themes="$(jq -cn --argjson items "$themes" --argjson item "$item" '$items+[$item]')"
  done < <(theme_ids)
  jq -cn --argjson theme "$theme_id" --argjson release "$release_id" --argjson themes "$themes" '{schema_version:1,data:{theme_id:$theme,release_id:$release,themes:$themes}}'
}

command_name="${1:-}"
case "$command_name" in set|choose|reload) lock_appearance;; esac
case "$command_name" in
  snapshot) (($# == 1)) || exit 2; need_command jq; public_snapshot ;;
  list)
    (($# == 1)) || { usage >&2; exit 2; }
    need_command jq
    while IFS= read -r theme_id; do
      [[ -n "$theme_id" ]] || continue
      printf '%s\t%s\n' "$theme_id" "$(json_value '.name' "$(manifest_for_theme "$theme_id")")"
    done < <(theme_ids)
    ;;
  current)
    (($# == 1)) || { usage >&2; exit 2; }
    ensure_state_root
    if [[ -L "$current_link" ]]; then
      jq -er '.id' -- "$(pointer_target "$current_link")/manifest.json"
    elif [[ -f "$selected_file" ]]; then
      cat -- "$selected_file"
    else
      printf 'none\n'
    fi
    ;;
  validate)
    (($# == 2)) || { usage >&2; exit 2; }
    if [[ "$2" == '--all' ]]; then
      mapfile -t ids < <(theme_ids)
      ((${#ids[@]})) || fail 'no themes are available'
      for theme_id in "${ids[@]}"; do
        validate_theme "$theme_id"
        printf 'valid: %s\n' "$theme_id"
      done
    else
      validate_theme "$2"
      printf 'valid: %s\n' "$2"
    fi
    ;;
  set)
    (($# >= 2 && $# <= 3)) || { usage >&2; exit 2; }
    no_reload=false
    if (($# == 3)); then
      [[ "$3" == '--no-reload' ]] || { usage >&2; exit 2; }
      no_reload=true
    fi
    [[ "${BLENDOS_WORKSTATION_THEME_NO_RELOAD:-0}" == '1' ]] && no_reload=true
    set_theme "$2" "$no_reload"
    ;;
  choose)
    (($# == 1)) || { usage >&2; exit 2; }
    choose_theme
    ;;
  reload)
    (($# == 1)) || { usage >&2; exit 2; }
    reload_current
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
