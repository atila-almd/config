{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blendos-workstation.local/schemas/theme-v1.json",
  "title": "blendOS Workstation theme manifest",
  "description": "The version-1 semantic palette contract for the workstation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "mode",
    "colors",
    "terminal",
    "wallpapers",
    "gtk"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["dark", "light"]
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accent",
        "selection",
        "muted",
        "background",
        "background_alt",
        "surface",
        "surface_alt",
        "foreground",
        "foreground_muted",
        "red",
        "orange",
        "yellow",
        "green",
        "cyan",
        "blue",
        "magenta"
      ],
      "patternProperties": {
        ".*": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["palette"],
      "properties": {
        "palette": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    },
    "wallpapers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gtk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "icon_theme", "cursor_theme"],
      "properties": {
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "icon_theme": {
          "type": "string",
          "minLength": 1
        },
        "cursor_theme": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
