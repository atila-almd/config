[global]
frame_color = "${THEME_ACCENT}"
separator_color = "${THEME_SURFACE_ALT}"
highlight = "${THEME_ACCENT}"
progress_bar_color = "${THEME_ACCENT}"

[urgency_low]
background = "${THEME_BACKGROUND_ALT}"
foreground = "${THEME_FOREGROUND_MUTED}"
frame_color = "${THEME_MUTED}"

[urgency_normal]
background = "${THEME_SURFACE}"
foreground = "${THEME_FOREGROUND}"
frame_color = "${THEME_ACCENT}"

[urgency_critical]
background = "${THEME_RED}"
foreground = "${THEME_BACKGROUND}"
frame_color = "${THEME_ORANGE}"
